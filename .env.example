# === BACKEND (Node.js + Express) ===
PORT=5000
NODE_ENV=development
CORS_ORIGIN=localhost:5173

# === AI INTEGRATION (Студент 2) ===
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-2.5-flash

# === FIREBASE ADMIN SDK (Студент 3) ===
FIREBASE_PROJECT_ID=nora-ai-university
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-account
FIREBASE_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY_HERE"

# === FRONTEND (React + Vite — Студент 4) ===
VITE_API_BASE_URL=/api
VITE_FIREBASE_API_KEY=your_public_firebase_api_key
VITE_FIREBASE_PROJECT_ID=nora-ai-university

{
  "name": "nora-poc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"tests/**/*.{mjs,ts,tsx}\" \"*.{js,mjs,ts,json}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"tests/**/*.{mjs,ts,tsx}\" \"*.{js,mjs,ts,json}\"",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && vitest run",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "isbot": "^5.1.40",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@react-router/dev": "^8.5.1",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.0.3",
    "vitest": "^4.0.0"
  }
}
